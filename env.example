# ============================================================
# av-physics-mae — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Compute ─────────────────────────────────────────────────
CUDA_VISIBLE_DEVICES=0               # GPU index (0, 1, 2... or "0,1" for multi-GPU)

# ── Dataset Paths ───────────────────────────────────────────
LRS3_ROOT=/path/to/lrs3              # Root directory of LRS3 dataset
VOXCELEB2_ROOT=/path/to/voxceleb2   # Root directory of VoxCeleb2 dataset
AVDF1M_ROOT=/path/to/avdf1m         # Root directory of AV-Deepfake1M++

# ── Output Paths ────────────────────────────────────────────
CHECKPOINT_DIR=./checkpoints         # Where model checkpoints are saved
LOG_DIR=./logs                       # Where training logs are written

# ── Experiment Tracking ─────────────────────────────────────
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=av-physics-mae
WANDB_ENTITY=your_wandb_username_or_team

# ── Reproducibility ─────────────────────────────────────────
SEED=42
